    <!-- Features Section -->
    <section id="features">
        <div class="container">
            <div class="row text-center">
                <div class="col-lg-12">
                    <h2>Features</h2>
                    <hr class="cogs-primary">
                </div>
            </div>
            <div class="row text-center">
                <div class="col-md-4">
                    <i class="fa fa-brain fa-3x feature-icon"></i>
                    <h3>Smart Conversations</h3>
                    <p>Engage in dynamic, context-aware, and intelligent interactions powered by state-of-the-art AI.
                    </p>
                </div>
                <div class="col-md-4">
                    <i class="fa fa-lock fa-3x feature-icon"></i>
                    <h3>Privacy First</h3>
                    <p>Your data is safe. ChatUCY keeps no data to ensure your privacy.</p>
                </div>
                <div class="col-md-4">
                    <i class="fa fa-boxes-stacked fa-3x feature-icon"></i>
                    <h3>Multiple AI Agents</h3>
                    <p>Choose your favourite AI Model to have a conversation.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- How It Works Section -->
    <section id="how-works" class="bg-light">
        <div class="container">
            <div class="row text-center">
                <div class="col-12">
                    <h2>How It Works</h2>
                    <hr class="cogs-primary">
                </div>
            </div>
            <div class="row text-center">
                <div class="col-12">
                    <i class="fas fa-comment-dots fa-3x"></i>
                    <h3>ChatUCY</h3>
                    <p>
                        ChatUCY works by directly forwarding your query to a large language model for processing – all
                        without storing any data. This ensures your privacy while providing fast and intelligent
                        responses. Additionally, all chat history is saved on your device, keeping your interactions
                        secure and private.
                    </p>
                </div>
            </div>
        </div>
    </section>



    <!-- About Section -->
    <section id="about" class="success">
        <div class="container">
            <div class="row text-center">
                <div class="col-lg-12">
                    <h2>About</h2>
                    <hr class="info-light">
                </div>
            </div>
            <div class="row">
                <div class="col-lg-8 offset-lg-2">
                    <p>ChatUCY is an AI chatbot platform developed to assist users across various tasks, enabling smooth
                        and natural interactions. Whether you're seeking information, assistance, or simply engaging in
                        a conversation, ChatUCY is your free-to-use platform.</p>
                </div>
            </div>
        </div>
    </section>

