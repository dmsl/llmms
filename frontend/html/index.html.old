                <!-- Contributor 2 -->
                <div class="col-12 col-lg-6 mb-4">
                    <div class="team-member">
                        <a href="https://www.linkedin.com/in/kkrasov/" target="_blank">
                            <div id="tm-kk" class="team-img"></div>
                        </a>
                        <div class="team-content">
                            <a href="https://www.linkedin.com/in/kkrasov/" target="_blank">
                                <h2>Konstantin Krasovitskity</h2>
                            </a>
                            <h3>Platform Developer &amp; System Administrator</h3>
                        </div>
                    </div>
                </div>
                <!-- Contributor 3 -->
                <div class="col-12 col-lg-6 mb-4">
                    <div class="team-member">
                        <div id="tm-dp" class="team-img"></div>
                        <div class="team-content">
                            <h2>Demetra Paphitou</h2>
                            <h3>Researcher: Features Researcher</h3>
                        </div>
                    </div>
                </div>
                <!-- Contributor 4 -->
                <div class="col-12 col-lg-6 mb-4">
                    <div class="team-member">
                        <a href="https://www.linkedin.com/in/stelioschristou/" target="_blank">
                            <div id="tm-sc" class="team-img"></div>
                        </a>
                        <div class="team-content">
                            <a href="https://www.linkedin.com/in/stelioschristou/" target="_blank">
                                <h2>Stelios Christou</h2>
