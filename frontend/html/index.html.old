                    <div class="team-member">
                        <a href="http://www.cs.ucy.ac.cy/~dzeina/" target="_blank">
                            <div id="tm-dz" class="team-img">
                                <!-- Insert background image or <img> here -->
                            </div>
                        </a>
                        <div class="team-content">
                            <a href="http://www.cs.ucy.ac.cy/~dzeina/" target="_blank">
                                <h2>Demetris Zeinalipour</h2>
                            </a>
