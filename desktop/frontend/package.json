{
  "name": "llmms-frontend",
  "version": "2.0.0",
  "description": "LLM Meta Search - Modern Frontend",
  "scripts": {
    "dev": "echo 'Development mode: Open html/llmms-modern.html in browser'",
    "build:css": "npx tailwindcss -i ./src/input.css -o ./dist/output.css --minify",
    "watch:css": "npx tailwindcss -i ./src/input.css -o ./dist/output.css --watch"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@tensorflow-models/universal-sentence-encoder": "^1.3.3",
    "@tensorflow/tfjs": "^4.22.0",
    "alpinejs": "^3.15.11",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "marked": "^18.0.2",
    "xlsx": "^0.18.5"
  }
}
